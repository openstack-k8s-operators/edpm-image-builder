#!/bin/bash

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

# Must sort after the sysprep element's 99-clear-machine-id, which writes
# "uninitialized" and would trigger first boot semantics. Truncating to empty
# instead makes systemd generate a new machine-id without running
# ConditionFirstBoot units or preset-all. reset-bls-entries then renames BLS
# entries to match it.
if [ -e /etc/machine-id ]; then
    > /etc/machine-id
fi

if [ -e /var/lib/dbus/machine-id ]; then
    > /var/lib/dbus/machine-id
fi

#!/usr/bin/bash

set -eux

machine_id=$(</etc/machine-id)
if ! [[ $machine_id =~ ^[0-9a-f]{32}$ ]]; then
    echo "machine-id is not initialized, nothing to do"
    exit 0
fi

cd /boot/loader/entries
for entry in *.conf; do
    [[ -e $entry ]] || continue
    new_entry="${machine_id}-${entry#*-}"
    if [[ $entry != "$new_entry" ]]; then
        echo "renaming $entry to $new_entry for new machine-id"
        mv "$entry" "$new_entry"
    fi
done
